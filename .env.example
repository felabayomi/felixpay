NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Existing independent FelixPay Neon/PostgreSQL database. Do not use db:push
# until the target database and migration have been reviewed.
DATABASE_URL=

# Shared Clerk application used across the Felix Financial Suite.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5000

# Central cross-product membership verification.
MEMBERSHIP_VERIFY_API_KEY=
ADMIN_EMAILS=

# Stripe membership and balance payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
MEMBERSHIP_PRICE_CONTROL_MONTHLY=
MEMBERSHIP_PRICE_CONTROL_ANNUAL=
MEMBERSHIP_PRICE_MOMENTUM_MONTHLY=
MEMBERSHIP_PRICE_MOMENTUM_ANNUAL=
MEMBERSHIP_PRICE_LEGACY_MONTHLY=
MEMBERSHIP_PRICE_LEGACY_ANNUAL=

# BillWatch import bridge.
BILLWATCH_EXPORT_URL=
BILLWATCH_EXPORT_TOKEN=

# Optional background jobs and check-mailing integrations.
REDIS_URL=
FELIXCHECK_API_URL=
FELIXCHECK_API_KEY=
CHECKBOOK_API_KEY=
CHECKBOOK_API_SECRET=
CHECKBOOK_ACCOUNT_NUMBER=
CHECKBOOK_ROUTING_NUMBER=
CHECKBOOK_BANK_NAME=
MERCURY_API_TOKEN=
ENABLE_MERCURY_FUNDING=false
